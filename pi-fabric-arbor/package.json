{
  "name": "pi-fabric-arbor",
  "version": "0.1.0",
  "description": "Source-loaded Arbor add-on for Pi and pi-fabric",
  "type": "module",
  "main": "./src/package.ts",
  "types": "./src/package.ts",
  "exports": {
    ".": {
      "types": "./src/package.ts",
      "import": "./src/package.ts"
    },
    "./extension": {
      "types": "./src/extension.ts",
      "import": "./src/extension.ts"
    },
    "./assets": {
      "types": "./src/package.ts",
      "import": "./src/package.ts"
    }
  },
  "bin": {
    "pi-fabric-arbor": "./bin/pi-fabric-arbor.mjs"
  },
  "files": [
    "bin/pi-fabric-arbor.mjs",
    "src/cli/",
    "src/extension.ts",
    "src/managed/",
    "src/research/",
    "src/evaluators/",
    "src/material/",
    "src/presets/",
    "examples/",
    "src/package-layout.ts",
    "src/package.ts",
    "src/web/SourceWebAssets.ts",
    "web/read-only/",
    "skills/fabric-arbor/",
    "docs/consumer-installation.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "acceptance-ledger.md",
    "docs/pr3-action-manifest.json",
    "src/presentation/",
    "docs/role-maintenance.md",
    "docs/pr13-cutover-evidence.md",
    "docs/research-configuration.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:source",
    "test:source": "npm run test:source:package && npm run test:pr2 && npm run test:pr3 && npm run test:pr4 && npm run test:pr5",
    "test:source:package": "node --import tsx --test 'tests/package/*.test.ts'",
    "test:pr1": "node --import tsx --test 'tests/package/pr1-*.test.ts'",
    "check": "npm run typecheck && npm run typecheck:test && npm test",
    "test:pr11": "node --import tsx --test tests/research/pr11-presets.test.ts",
    "test:pr11:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr11-examples-host.test.ts",
    "test:pr10": "node --import tsx --test --test-name-pattern=PR10 tests/research/pr10-delayed.test.ts tests/research/pr10-experience.test.ts tests/research/pr10-review-bounds.test.ts tests/research/pr10-grounding.test.ts tests/research/pr6-roles.test.ts tests/material/pr5-journey.test.ts",
    "test:pr10:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr10-grounding-host.test.ts tests/integration/pr10-experience-host.test.ts",
    "test:pr10:experience:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr10-experience-host.test.ts",
    "test:pr9": "node --import tsx --test --test-name-pattern=PR9 tests/material/pr5-journey.test.ts tests/research/pr9-contracts.test.ts",
    "test:pr9:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr9-held-out-host.test.ts",
    "test:pr8": "node --import tsx --test --test-name-pattern=PR8 tests/material/pr5-journey.test.ts tests/material/pr8-source-apply.test.ts",
    "test:pr8:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr8-controls-host.test.ts tests/integration/pr8-crash-host.test.ts tests/integration/pr8-recovery-host.test.ts tests/integration/pr8-reload-regressions.test.ts",
    "test:pr7": "node --import tsx --test tests/research/pr7-tree.test.ts tests/research/store.test.ts tests/material/pr5-journey.test.ts",
    "test:pr7:e2e": "node --import tsx --test --test-concurrency=1 tests/integration/pr7-parallel-host.test.ts tests/integration/pr7-controls-host.test.ts tests/integration/pr7-repairs-host.test.ts",
    "test:pr6": "node --import tsx --test tests/research/pr6-*.test.ts",
    "test:pr6:e2e": "node --import tsx --test tests/integration/pr6-research-host.test.ts",
    "test:pr5": "node --import tsx --test tests/material/*.test.ts",
    "test:pr5:e2e": "node --import tsx --test tests/integration/pr5-material-host.test.ts",
    "test:pr4": "node --import tsx --test tests/evaluators/*.test.ts",
    "test:pr4:e2e": "node --import tsx --test tests/integration/pr4-evaluator-host.test.ts",
    "test:pr2": "node --import tsx --test tests/managed/*.test.ts",
    "test:pr2:e2e": "node --import tsx --test tests/integration/pr2-production-host.test.ts",
    "test:pr3": "node --import tsx --test tests/research/*.test.ts",
    "test:pr3:e2e": "node --import tsx --test tests/integration/pr3-research-host.test.ts",
    "manifest:pr3": "node --import tsx tests/research/export-manifest.ts",
    "test:pr12": "node --import tsx --test --test-name-pattern=PR12 tests/research/pr12-*.test.ts tests/research/service.test.ts tests/material/pr5-journey.test.ts",
    "test:pr12:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.runtime/pr12-browsers\" node --import tsx --test --test-concurrency=1 tests/integration/pr12-presentation-host.test.ts tests/integration/pr12-component-reload.test.ts tests/integration/pr12-lifetime-host.test.ts",
    "test:pr13": "node --import tsx --test --test-name-pattern=PR13 tests/package/pr13-cutover.test.ts tests/evaluators/measurement.test.ts tests/material/pr5-workspace.test.ts tests/research/service.test.ts",
    "test:pr13:e2e": "npm run test:pr12:e2e && npm run test:pr11:e2e",
    "audit:pr13": "node --import tsx tests/research/pr13-audit.ts"
  },
  "keywords": [
    "pi-package",
    "pi-fabric",
    "research-orchestration"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills/fabric-arbor/SKILL.md"
    ]
  },
  "dependencies": {
    "tsx": "4.23.13"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-fabric": ">=0.83.0 <0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.0.0",
    "pi-fabric": "0.83.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
