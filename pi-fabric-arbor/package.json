{
  "name": "pi-fabric-arbor",
  "version": "0.1.0",
  "description": "Source-loaded Arbor add-on for Pi and pi-fabric",
  "type": "module",
  "main": "./src/package.ts",
  "types": "./src/package.ts",
  "exports": {
    ".": {
      "types": "./src/package.ts",
      "import": "./src/package.ts"
    },
    "./extension": {
      "types": "./src/extension.ts",
      "import": "./src/extension.ts"
    },
    "./assets": {
      "types": "./src/package.ts",
      "import": "./src/package.ts"
    }
  },
  "bin": {
    "pi-fabric-arbor": "./bin/pi-fabric-arbor.mjs"
  },
  "files": [
    "bin/pi-fabric-arbor.mjs",
    "src/cli/",
    "src/extension.ts",
    "src/managed/",
    "src/research/",
    "src/evaluators/",
    "src/presets/",
    "examples/pr4-agent-improvement/",
    "docs/pr4-evaluator-evidence.md",
    "src/package-layout.ts",
    "src/package.ts",
    "src/web/SourceWebAssets.ts",
    "web/read-only/",
    "skills/fabric-arbor/",
    "docs/pr0-owner-local-evidence.md",
    "docs/pr1-source-install-evidence.md",
    "docs/consumer-installation.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "acceptance-ledger.md",
    "docs/pr2-managed-owner-evidence.md",
    "docs/pr3-interface-evidence.md",
    "docs/pr3-action-manifest.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:source",
    "test:source": "npm run test:source:package && npm run test:source:retained && npm run test:pr2 && npm run test:pr3 && npm run test:pr4",
    "test:source:package": "node --import tsx --test 'tests/package/*.test.ts'",
    "test:source:retained": "node --import tsx --test 'tests/model/*.test.ts' tests/git/fingerprint.test.ts tests/git/workspace.test.ts tests/git/promotion-candidate.test.ts 'tests/persistence/*.test.ts' tests/recovery/dispatch.test.ts tests/recovery/outbox.test.ts tests/recovery/report.test.ts tests/recovery/fault-matrix.test.ts tests/recovery/cleanup.test.ts tests/recovery/phase4-application.test.ts tests/recovery/phase4-boundaries.test.ts tests/reports/completeness.test.ts tests/concurrency/commands.test.ts tests/evaluation/protocol.test.ts tests/compatibility/components.test.ts tests/compatibility/provider.test.ts tests/e2e/fixture-driver.test.ts",
    "test:pr1": "node --import tsx --test 'tests/package/pr1-*.test.ts'",
    "test:pr0:plan": "node --experimental-strip-types --test tests/integration/pr0-plan-architecture-consistency.test.ts",
    "test:pr0:e2e": "node --experimental-strip-types --test 'tests/integration/pr0-owner-local-*.test.ts'",
    "check": "npm run typecheck && npm run typecheck:test && npm test",
    "test:pr4": "node --import tsx --test tests/evaluators/*.test.ts",
    "test:pr4:e2e": "node --import tsx --test tests/integration/pr4-evaluator-host.test.ts",
    "test:pr2": "node --import tsx --test tests/managed/*.test.ts",
    "test:pr2:e2e": "node --import tsx --test tests/integration/pr2-production-host.test.ts",
    "test:pr3": "node --import tsx --test tests/research/*.test.ts",
    "test:pr3:e2e": "node --import tsx --test tests/integration/pr3-research-host.test.ts",
    "manifest:pr3": "node --import tsx tests/research/export-manifest.ts"
  },
  "keywords": [
    "pi-package",
    "pi-fabric",
    "research-orchestration"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills/fabric-arbor/SKILL.md"
    ]
  },
  "dependencies": {
    "tsx": "4.23.13"
  },
  "peerDependencies": {
    "pi-fabric": ">=0.83.0 <0.84.0",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.0.0",
    "pi-fabric": "0.83.0",
    "typescript": "6.0.3"
  }
}
