{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/budget-ledger.schema.json",
  "title": "Pre-launch global call and cost reservation ledger",
  "type": "object",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reservation": {
      "type": "object",
      "required": [
        "reservation_id",
        "traffic",
        "direct_calls",
        "declared_descendant_calls",
        "reserved_calls",
        "projected_cost"
      ],
      "properties": {
        "reservation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "traffic": {"enum": ["attempt", "judge", "adjudicate", "audit", "canary"]},
        "direct_calls": {"type": "integer", "minimum": 0},
        "declared_descendant_calls": {"type": "integer", "minimum": 0},
        "reserved_calls": {"type": "integer", "minimum": 1},
        "projected_cost": {"$ref": "#/$defs/decimal"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "ledger_version",
    "budget_id",
    "status",
    "launch_allowed",
    "maximum_calls",
    "maximum_cost",
    "cost_unit",
    "reservations",
    "reserved_direct_calls",
    "reserved_descendant_calls",
    "reserved_calls",
    "reserved_cost",
    "remaining_calls",
    "remaining_cost"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ledger_version": {"type": "string", "minLength": 1},
    "budget_id": {"type": "string", "pattern": "^budget-[0-9a-f]{24}$"},
    "status": {"const": "reserved"},
    "launch_allowed": {"const": true},
    "maximum_calls": {"type": "integer", "minimum": 1},
    "maximum_cost": {"$ref": "#/$defs/decimal"},
    "cost_unit": {"type": "string", "minLength": 1},
    "reservations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reservation"}
    },
    "reserved_direct_calls": {"type": "integer", "minimum": 0},
    "reserved_descendant_calls": {"type": "integer", "minimum": 0},
    "reserved_calls": {"type": "integer", "minimum": 1},
    "reserved_cost": {"$ref": "#/$defs/decimal"},
    "remaining_calls": {"type": "integer", "minimum": 0},
    "remaining_cost": {"$ref": "#/$defs/decimal"}
  },
  "additionalProperties": false
}
