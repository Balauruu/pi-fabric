{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/grader.schema.json",
  "title": "Frozen benchmark grader",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "grader_id",
    "revision",
    "kind",
    "blind",
    "criteria",
    "fixtures",
    "prompt_path",
    "output_schema_path",
    "model",
    "provider_native"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "grader_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "kind": {"enum": ["deterministic", "model", "human"]},
    "blind": {"type": "boolean"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "$comment": "criterion_id uniqueness and positive total weight are enforced by lifecycle reconciliation",
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "evidence_type", "weight", "fatal"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "description": {"type": "string", "minLength": 1},
          "evidence_type": {"enum": ["final-state", "citation-entailment", "process", "judgment"]},
          "weight": {"type": "number", "minimum": 0},
          "fatal": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "fixtures": {
      "type": "object",
      "required": ["known_good", "known_bad", "isolated_defect", "boundary", "malformed"],
      "properties": {
        "known_good": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "safe-relative-path"}},
        "known_bad": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "safe-relative-path"}},
        "isolated_defect": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "safe-relative-path"}},
        "boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "safe-relative-path"}},
        "malformed": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "safe-relative-path"}}
      },
      "additionalProperties": false
    },
    "prompt_path": {"type": ["string", "null"], "format": "safe-relative-path"},
    "output_schema_path": {"type": "string", "format": "safe-relative-path"},
    "model": {
      "type": ["object", "null"],
      "required": ["requested", "resolved", "observed"],
      "properties": {
        "requested": {"type": ["string", "null"], "minLength": 1},
        "resolved": {"type": ["string", "null"], "minLength": 1},
        "observed": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "provider_native": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
