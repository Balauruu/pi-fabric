{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/schedule-row.schema.json",
  "title": "Frozen benchmark schedule row",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "schedule_revision",
    "schedule_mode",
    "attempt_id",
    "task_id",
    "condition_id",
    "repetition",
    "block",
    "order_position",
    "wave",
    "worker_slot",
    "retry_of"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "schedule_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "schedule_mode": {"enum": ["comparative", "single-condition-smoke"]},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "condition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repetition": {"type": "integer", "minimum": 1},
    "block": {"type": "integer", "minimum": 1},
    "order_position": {"type": "integer", "minimum": 1},
    "wave": {"type": "integer", "minimum": 1},
    "worker_slot": {"type": "integer", "minimum": 1},
    "retry_of": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
  },
  "additionalProperties": false
}
