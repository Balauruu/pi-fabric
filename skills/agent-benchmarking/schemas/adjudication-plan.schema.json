{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/adjudication-plan.schema.json",
  "title": "Frozen disagreement adjudication plan",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "plan_revision",
    "jobs",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "plan_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "jobs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/job"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "source_judge_result": {
      "type": "object",
      "required": ["grader_id", "grader_revision", "result_path", "result_digest"],
      "properties": {
        "grader_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "grader_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "result_path": {"type": "string", "format": "safe-relative-path"},
        "result_digest": {"type": "string", "format": "sha256"}
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "required": [
        "attempt_id",
        "blind_id",
        "task_id",
        "adjudicator_id",
        "adjudicator_revision",
        "source_judge_results"
      ],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "blind_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "adjudicator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "adjudicator_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "source_judge_results": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_judge_result"}
        }
      },
      "additionalProperties": false
    }
  }
}
