{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/result.schema.json",
  "title": "Benchmark run and report result",
  "description": "Compact public result returned by the file-backed run and read-only report operations.",
  "type": "object",
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "nullable_path": {"type": ["string", "null"], "minLength": 1},
    "error": {
      "type": "object",
      "required": ["code", "message", "workId"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "workId": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "runDirectory",
    "phase",
    "counts",
    "nextAction",
    "errors",
    "limitations",
    "reportPaths",
    "scientificDecision"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["complete", "checkpoint", "blocked", "unsupported", "failed"]},
    "runDirectory": {"type": "string", "pattern": "^/", "minLength": 1},
    "phase": {"enum": ["initialize", "execute", "grade", "analyze", "finalize", "complete", "inspect"]},
    "counts": {
      "type": "object",
      "required": ["planned", "assigned", "terminal", "failed", "unresolved", "pending"],
      "properties": {
        "planned": {"$ref": "#/$defs/count"},
        "assigned": {"$ref": "#/$defs/count"},
        "terminal": {"$ref": "#/$defs/count"},
        "failed": {"$ref": "#/$defs/count"},
        "unresolved": {"$ref": "#/$defs/count"},
        "pending": {"$ref": "#/$defs/count"}
      },
      "additionalProperties": false
    },
    "nextAction": {"type": ["string", "null"], "minLength": 1},
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reportPaths": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"$ref": "#/$defs/nullable_path"},
        "markdown": {"$ref": "#/$defs/nullable_path"}
      },
      "additionalProperties": false
    },
    "scientificDecision": {
      "enum": ["adopt", "retain-control", "inconclusive", "descriptive-only", null]
    }
  },
  "additionalProperties": false
}
