{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/runtime-capability.schema.json",
  "title": "Installed Pi Fabric runtime capability receipt",
  "type": "object",
  "required": [
    "schema_version",
    "mechanics_version",
    "status",
    "capability_id",
    "pi_version",
    "fabric_version",
    "effective_max_calls",
    "max_concurrency",
    "recursive_agents",
    "recursive_custom_cwd",
    "absolute_log_roots",
    "telemetry_projection_version",
    "actor_mesh_default_root",
    "actor_mesh_root_env",
    "temporary_log_pattern",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mechanics_version": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "capability_id": {"type": "string", "pattern": "^runtime-[0-9a-f]{24}$"},
    "pi_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "fabric_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "effective_max_calls": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
    "recursive_agents": {"const": true},
    "recursive_custom_cwd": {"const": false},
    "absolute_log_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "telemetry_projection_version": {"type": "string", "minLength": 1},
    "actor_mesh_default_root": {"const": ".pi/fabric/mesh"},
    "actor_mesh_root_env": {"const": "PI_FABRIC_MESH_ROOT"},
    "temporary_log_pattern": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
