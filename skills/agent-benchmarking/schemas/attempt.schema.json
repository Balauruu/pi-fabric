{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/attempt.schema.json",
  "title": "Immutable benchmark attempt terminal",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "schedule_revision",
    "attempt_id",
    "task_id",
    "condition_id",
    "repetition",
    "wave",
    "worker_slot",
    "retry_of",
    "stage",
    "status",
    "qualifiers",
    "failure",
    "startup_state",
    "assigned_at",
    "started_at",
    "terminal_at",
    "requested_runtime",
    "resolved_runner",
    "requested_model",
    "resolved_model",
    "observed_model",
    "fabric_result",
    "log_path",
    "session_path",
    "process_evidence_path",
    "mechanism_evidence_path",
    "artifact_paths"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "schedule_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "condition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repetition": {"type": "integer", "minimum": 1},
    "wave": {"type": "integer", "minimum": 1},
    "worker_slot": {"type": "integer", "minimum": 1},
    "retry_of": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "stage": {"const": "execute"},
    "status": {"enum": ["succeeded", "failed", "cancelled", "timed-out", "prelaunch-failed", "invalid"]},
    "qualifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["mechanism-unverified", "nested-agents-present", "nested-telemetry-incomplete", "finalization-error", "runtime-unobserved", "budget-exhausted", "protected-state-conflict", "confounded", "analysis-limited"]}
    },
    "failure": {
      "type": ["object", "null"],
      "required": ["stage", "code", "classification", "message", "retryable"],
      "properties": {
        "stage": {"enum": ["execute", "judge", "adjudicate", "finalize"]},
        "code": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "startup_state": {"enum": ["not-started", "started"]},
    "assigned_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "terminal_at": {"type": "string", "format": "date-time"},
    "requested_runtime": {"type": ["string", "null"], "minLength": 1},
    "resolved_runner": {"type": ["string", "null"], "minLength": 1},
    "requested_model": {"type": ["string", "null"], "minLength": 1},
    "resolved_model": {"type": ["string", "null"], "minLength": 1},
    "observed_model": {"type": ["string", "null"], "minLength": 1},
    "fabric_result": {
      "type": "object",
      "required": ["agent_id", "status", "model", "session_id", "output", "error", "usage", "turns", "tool_calls", "started_at", "ended_at", "provider_native"],
      "properties": {
        "agent_id": {"type": ["string", "null"], "minLength": 1},
        "status": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "session_id": {"type": ["string", "null"], "minLength": 1},
        "output": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd", "provider_native"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cost_usd": {"type": ["number", "null"], "minimum": 0},
            "provider_native": {"type": "object", "additionalProperties": true}
          },
          "additionalProperties": false
        },
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequence", "name", "status"],
            "properties": {
              "sequence": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["succeeded", "failed", "cancelled", "unknown"]}
            },
            "additionalProperties": false
          }
        },
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"},
        "provider_native": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "log_path": {"type": ["string", "null"], "format": "safe-relative-path"},
    "session_path": {"type": ["string", "null"], "format": "safe-relative-path"},
    "process_evidence_path": {"type": ["string", "null"], "format": "safe-relative-path"},
    "mechanism_evidence_path": {"type": "string", "format": "safe-relative-path"},
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "safe-relative-path"}
    }
  },
  "additionalProperties": false
}
