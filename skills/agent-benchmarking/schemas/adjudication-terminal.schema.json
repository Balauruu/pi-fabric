{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/adjudication-terminal.schema.json",
  "title": "Immutable adjudication terminal artifact",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "plan_revision",
    "attempt_id",
    "task_id",
    "blind_id",
    "grader_id",
    "grader_revision",
    "stage",
    "status",
    "terminal_at",
    "result_path",
    "result_sha256",
    "raw_path",
    "raw_sha256",
    "log_path"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "plan_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "blind_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "grader_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "grader_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "stage": {"const": "adjudicate"},
    "status": {"enum": ["passed", "failed", "abstained", "grader-error", "invalid"]},
    "terminal_at": {"type": "string", "format": "date-time"},
    "result_path": {"type": "string", "format": "safe-relative-path"},
    "result_sha256": {"type": "string", "format": "sha256"},
    "raw_path": {"type": "string", "format": "safe-relative-path"},
    "raw_sha256": {"type": "string", "format": "sha256"},
    "log_path": {"type": ["string", "null"], "format": "safe-relative-path"}
  },
  "additionalProperties": false
}
