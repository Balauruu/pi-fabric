{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/call-plan.schema.json",
  "title": "Bounded Fabric call plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "benchmark_id",
    "stage",
    "call_ids",
    "max_calls",
    "max_concurrency",
    "reserved_descendant_calls",
    "reserved_calls",
    "predecessor_checkpoint_path"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^calls-[0-9a-f]{24}$"},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "stage": {"enum": ["execute", "judge", "adjudicate", "audit"]},
    "call_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    },
    "max_calls": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
    "reserved_descendant_calls": {"type": "integer", "minimum": 0, "maximum": 99},
    "reserved_calls": {"type": "integer", "minimum": 1, "maximum": 100},
    "predecessor_checkpoint_path": {"type": ["string", "null"], "format": "safe-relative-path"}
  },
  "additionalProperties": false
}
