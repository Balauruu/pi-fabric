{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/agent-benchmarking/telemetry.schema.json",
  "title": "Benchmark attempt telemetry",
  "type": "object",
  "$defs": {
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd", "provider_native"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "provider_native": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "agent_id",
        "parent_agent_id",
        "session_id",
        "requested_model",
        "resolved_model",
        "observed_model",
        "direct_usage",
        "tool_calls",
        "latency_ms",
        "provider_native"
      ],
      "properties": {
        "agent_id": {"type": ["string", "null"], "minLength": 1},
        "parent_agent_id": {"type": ["string", "null"], "minLength": 1},
        "session_id": {"type": ["string", "null"], "minLength": 1},
        "requested_model": {"type": ["string", "null"], "minLength": 1},
        "resolved_model": {"type": ["string", "null"], "minLength": 1},
        "observed_model": {"type": ["string", "null"], "minLength": 1},
        "direct_usage": {"$ref": "#/$defs/usage"},
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "count", "failed"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "provider_native": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "benchmark_id",
    "attempt_id",
    "estimate_version",
    "parent",
    "children",
    "child_ownership",
    "subtree_usage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "estimate_version": {"type": ["string", "null"], "minLength": 1},
    "parent": {"$ref": "#/$defs/entity"},
    "children": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entity"}},
    "child_ownership": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["child_agent_id", "owner_agent_id", "settlement_artifact_path"],
        "properties": {
          "child_agent_id": {"type": "string", "minLength": 1},
          "owner_agent_id": {"type": "string", "minLength": 1},
          "settlement_artifact_path": {"type": "string", "format": "safe-relative-path"}
        },
        "additionalProperties": false
      }
    },
    "subtree_usage": {"$ref": "#/$defs/usage"}
  },
  "additionalProperties": false
}
